# Copy to .env.local for local frontend dev (not used in Docker production build).
# Backend should be running via: docker compose -f docker-compose.dev.yml up -d

NEXT_PUBLIC_API_URL=http://localhost:4002/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Canonical public site origin — used for canonical URLs, OG tags, sitemap,
# robots.txt, and JSON-LD. MUST be set (without trailing slash) in every
# deployment environment; falls back to https://superluxere.com if unset.
NEXT_PUBLIC_SITE_URL=https://superluxere.com

# Google Analytics measurement ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
